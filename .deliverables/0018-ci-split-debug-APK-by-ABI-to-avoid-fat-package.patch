From 23890de40c8c74fd5f411dd898ab6788e8f56be0 Mon Sep 17 00:00:00 2001
From: JcEvoX <JcEvoX@users.noreply.github.com>
Date: Tue, 1 Sep 2026 11:03:01 +0000
Subject: [PATCH 18/18] ci: split debug APK by ABI to avoid fat package

Align debug build with release (--split-per-abi), producing separate
arm64-v8a / armeabi-v7a APKs instead of a single fat debug APK.
---
 .github/workflows/ci.yml | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 71a403c..407c204 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -56,16 +56,18 @@ jobs:
       - name: Run tests
         run: flutter test
 
-      - name: Build debug APK
+      - name: Build debug APKs (split by ABI)
         if: matrix.platform == 'android'
-        run: flutter build apk --debug
+        # 与 release 一致按 ABI 拆分，避免产出塞入所有架构的 fat APK。
+        # abiFilters 限定 arm64-v8a / armeabi-v7a，产物为两个独立 debug APK。
+        run: flutter build apk --debug --split-per-abi
 
-      - name: Upload debug APK artifact
+      - name: Upload debug APK artifacts
         if: matrix.platform == 'android'
         uses: actions/upload-artifact@v4
         with:
           name: notepad-debug-apk
-          path: build/app/outputs/flutter-apk/app-debug.apk
+          path: build/app/outputs/flutter-apk/app-*-debug.apk
           if-no-files-found: error
 
   ios:
-- 
2.43.0

