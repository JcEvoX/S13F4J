Subject: [PATCH 04/18] =?UTF-8?q?ci:=20=E8=AE=A9=20analyze=20=E5=BF=BD?=
 =?UTF-8?q?=E7=95=A5=20info=20=E7=BA=A7=20deprecated=20=E6=8F=90=E7=A4=BA?=
 =?UTF-8?q?=EF=BC=8C=E9=81=BF=E5=85=8D=E8=B7=A8=20Flutter=20=E7=89=88?=
 =?UTF-8?q?=E6=9C=AC=E8=AF=AF=E5=88=A4?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 .github/workflows/ci.yml      | 4 +++-
 .github/workflows/release.yml | 2 +-
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 5a58b15..c501da4 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -49,7 +49,9 @@ jobs:
         run: flutter pub get
 
       - name: Static analysis
-        run: flutter analyze
+        # --no-fatal-infos：不同 Flutter 版本对 deprecated 提示的 info 级别不同，
+        # 只阻断 warning / error，避免因版本差异导致误判失败。
+        run: flutter analyze --no-fatal-infos
 
       - name: Run tests
         run: flutter test
diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index d604636..957d78b 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -40,7 +40,7 @@ jobs:
         run: flutter pub get
 
       - name: Static analysis
-        run: flutter analyze
+        run: flutter analyze --no-fatal-infos
 
       - name: Run tests
         run: flutter test
-- 
