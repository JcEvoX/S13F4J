---
 .github/workflows/release.yml | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index 957d78b..7dc09ed 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -60,8 +60,10 @@ jobs:
       #     storeFile=../signing-key.jks
       #     EOF
 
-      - name: Build release APK
-        run: flutter build apk --release
+      - name: Build release APKs (split by ABI)
+        # --split-per-abi：分别产出 arm64-v8a / armeabi-v7a / x86_64 的独立 APK，
+        # 相比通用 fat APK 体积可缩减约 60%~70%，用户按设备架构下载安装。
+        run: flutter build apk --release --split-per-abi
 
       - name: Build release AAB
         run: flutter build appbundle --release
@@ -69,8 +71,11 @@ jobs:
       - name: Package artifacts
         run: |
           mkdir -p dist
-          cp build/app/outputs/flutter-apk/app-release.apk dist/
+          cp build/app/outputs/flutter-apk/app-arm64-v8a-release.apk dist/
+          cp build/app/outputs/flutter-apk/app-armeabi-v7a-release.apk dist/
+          cp build/app/outputs/flutter-apk/app-x86_64-release.apk dist/
           cp build/app/outputs/bundle/release/app-release.aab dist/
+          ls -lh dist/
 
       - name: Publish GitHub Release
         uses: softprops/action-gh-release@v2
