+name: Release
+
+# 推送 v* 版本标签（如 v1.0.0）时触发：编译 release 产物并发布到 GitHub Release。
+#
+# 说明：仓库默认未配置签名 keystore，Flutter 会使用 debug 签名生成可安装的 APK。
+# 如需正式签名发布，请在仓库 Settings -> Secrets 配置
+#   ANDROID_SIGNING_KEY  (base64 编码的 keystore)
+#   ANDROID_KEYSTORE_PASSWORD / ANDROID_KEY_ALIAS / ANDROID_KEY_PASSWORD
+# 并解除下方 release 签名步骤的注释。
+
+on:
+  push:
+    tags:
+      - 'v*'
+
+permissions:
+  contents: write
+
+jobs:
+  build:
+    name: Build release artifacts
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Set up JDK 17
+        uses: actions/setup-java@v4
+        with:
+          distribution: 'temurin'
+          java-version: '17'
+
+      - name: Set up Flutter
+        uses: subosito/flutter-action@v2
+        with:
+          channel: 'stable'
+          cache: true
+
+      - name: Install dependencies
+        run: flutter pub get
+
+      - name: Static analysis
+        run: flutter analyze
+
+      - name: Run tests
+        run: flutter test
+
+      # - name: Import signing keystore
+      #   if: env.ANDROID_SIGNING_KEY != ''
+      #   env:
+      #     ANDROID_SIGNING_KEY: ${{ secrets.ANDROID_SIGNING_KEY }}
+      #     ANDROID_KEYSTORE_PASSWORD: ${{ secrets.ANDROID_KEYSTORE_PASSWORD }}
+      #   run: |
+      #     echo "$ANDROID_SIGNING_KEY" | base64 -d > signing-key.jks
+      #     mkdir -p android/key.properties
+      #     cat > android/key.properties <<EOF
+      #     storePassword=$ANDROID_KEYSTORE_PASSWORD
+      #     keyPassword=${{ secrets.ANDROID_KEY_PASSWORD }}
+      #     keyAlias=${{ secrets.ANDROID_KEY_ALIAS }}
+      #     storeFile=../signing-key.jks
+      #     EOF
+
+      - name: Build release APK
+        run: flutter build apk --release
+
+      - name: Build release AAB
+        run: flutter build appbundle --release
+
+      - name: Package artifacts
+        run: |
+          mkdir -p dist
+          cp build/app/outputs/flutter-apk/app-release.apk dist/
+          cp build/app/outputs/bundle/release/app-release.aab dist/
+
+      - name: Publish GitHub Release
+        uses: softprops/action-gh-release@v2
+        with:
+          files: dist/*
+          generate_release_notes: true
+          draft: true
