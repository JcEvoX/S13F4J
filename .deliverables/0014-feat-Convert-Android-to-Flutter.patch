+  WallpaperOption(
+    key: 'Night',
+    title: '默认黑',
+    subtitle: 'Night',
+    colorValue: 0xFF141414,
+    isDark: true,
+  ),
+  WallpaperOption(
+    key: 'wood',
+    title: '原木',
+    subtitle: '朴实无华',
+    colorValue: 0xFFFFF5E4,
