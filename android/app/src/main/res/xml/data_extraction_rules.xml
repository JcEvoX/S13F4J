<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+：云备份与设备迁移均排除 appDataRoot（Notepad/）。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="Notepad" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="Notepad" />
    </device-transfer>
</data-extraction-rules>
